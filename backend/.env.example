# SafarNamma backend environment — copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# Any SQLAlchemy URL. Defaults to a local SQLite file (./roamlocal.db) when unset.
# Production uses Supabase Postgres, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Secret used to sign session tokens. STRONGLY recommended in production:
# without it (and without DATABASE_URL) a random per-process secret is used,
# so sign-ins reset on every restart. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Extra admin emails, comma-separated (added to the built-in team list).
ADMIN_EMAILS=

# Google OAuth client ID used to verify sign-in ID tokens.
GOOGLE_CLIENT_ID=

# Cloudinary credentials — required only for deleting uploaded images when a
# place is removed/rejected. Without them, asset cleanup is skipped safely.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
